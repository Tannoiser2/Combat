# Riempie state.map con la griglia completa della mappa richiesta.
static func fill(state: GameState, board_name: String) -> void:
	assert(TERRAIN.has(board_name), "Mappa sconosciuta: %s" % board_name)
	for col in range(1, COLS + 1):
		var last_row := LAST_ROW_ODD if col % 2 == 1 else LAST_ROW_EVEN
		for row in range(0, last_row + 1):
			state.map[GameState.hex_key(col, row)] = GameState.MapHex.new(D.Terrain.OPEN_LEVEL_0, 0)
	var tables: Dictionary = TERRAIN[board_name]
	for terrain in tables:
		for key in tables[terrain]:
			var hex: GameState.MapHex = state.map[key]
			hex.terrain = terrain
			match terrain:
				D.Terrain.OPEN_LEVEL_1: hex.level = 1
				D.Terrain.OPEN_LEVEL_2: hex.level = 2
