# Riempie state.map con la griglia completa di The Hedgerows.
static func fill_hedgerows(state: GameState) -> void:
	for col in range(1, HEDGEROWS_COLS + 1):
		var last_row := HEDGEROWS_LAST_ROW_ODD if col % 2 == 1 else HEDGEROWS_LAST_ROW_EVEN
		for row in range(0, last_row + 1):
			state.map[GameState.hex_key(col, row)] = GameState.MapHex.new(D.Terrain.OPEN_LEVEL_0, 0)
	for terrain in HEDGEROWS_TERRAIN:
		for key in HEDGEROWS_TERRAIN[terrain]:
			state.map[key].terrain = terrain
